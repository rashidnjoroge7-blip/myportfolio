# Comma-separated Supabase Auth email addresses allowed into the admin dashboard
ADMIN_EMAILS=admin@example.com

# Supabase public configuration
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key

# Server-only key for privileged CMS operations. Never expose with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_or_secret_key
